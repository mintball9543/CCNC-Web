# ──────────────────────────────────────────────
# 충청남도 탄소중립지원센터 웹사이트 환경 변수 예시
# 복사 후 값 변경:  cp .env.example .env
# 수정한 뒤에는 반드시 저장하고 서버를 재시작하세요. 점검: npm run env:check
# ──────────────────────────────────────────────

# 운영 도메인 (메타데이터 / og:url / sitemap 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 데이터베이스 (SQLite 파일 또는 libSQL 서버 URL)
DATABASE_URL=file:./data/ccnc.db
# DATABASE_AUTH_TOKEN=

# 관리자 세션 서명 키 (32자 이상 무작위 문자열)
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 최초 관리자 계정 (npm run db:seed 실행 시 생성, 운영 전 반드시 변경)
# ⚠ 비밀번호는 DB 에 저장됩니다. 이후 이 값을 바꿨다면 npm run admin:password 로 적용하세요.
# 로그인은 비밀번호만 입력 (아이디는 내부 식별용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now!

# 문의 답변 알림 메일 (SMTP) — 미설정 시 메일 발송 안 함
# MAIL_TRANSPORT=log 로 두면 실제 발송 없이 서버 로그에만 기록 (개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="충청남도 탄소중립지원센터 <no-reply@example.kr>"

# 업로드 파일 저장 위치 (기본: ./data/uploads)
# UPLOAD_DIR=
