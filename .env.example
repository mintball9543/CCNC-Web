# ──────────────────────────────────────────────
# 충청남도 탄소중립지원센터 웹사이트 환경 변수 예시
# 복사 후 값 변경:  cp .env.example .env
# 수정한 뒤에는 반드시 저장하고 서버를 재시작하세요. 점검: npm run env:check
# ──────────────────────────────────────────────

# 운영 도메인 (메타데이터 / og:url / sitemap 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 데이터베이스 (SQLite 파일 또는 libSQL 서버 URL)
DATABASE_URL=file:./data/ccnc.db
# DATABASE_AUTH_TOKEN=

# 관리자 세션 서명 키 (32자 이상 무작위 문자열)
#   생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 최초 관리자 계정 (npm run db:seed 실행 시 생성, 운영 전 반드시 변경)
# ⚠ 비밀번호는 DB 에 저장됩니다. 이후 이 값을 바꿨다면 npm run admin:password 로 적용하세요.
# 로그인은 비밀번호만 입력 (아이디는 내부 식별용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now!

# 문의 답변 알림 메일 (SMTP) — 미설정 시 메일 발송 안 함
# MAIL_TRANSPORT=log 로 두면 실제 발송 없이 서버 로그에만 기록 (개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 받는 사람에게는 이름(앞부분)이 크게 표시되고, 주소는 메일 상세 정보에서 보입니다(감출 수 없음).
# ⚠ Gmail 계정으로 보내면 Gmail 이 보내는 주소를 그 Gmail 주소로 바꿉니다. 개인 주소를 드러내지 않으려면
#   기관 메일 계정을 SMTP_USER 로 쓰거나 Gmail '다른 주소에서 메일 보내기'에 MAIL_FROM 주소를 등록하세요.
MAIL_FROM="충청남도 탄소중립지원센터 <no-reply@example.kr>"

# 네이버 지도 (센터소개 > 오시는 길) — 미설정 시 지도 대신 '네이버 지도에서 보기' 링크만 표시
#   네이버 클라우드 플랫폼 콘솔 > Maps > Application 등록
#   - 사용할 API: Dynamic Map, Geocoding(좌표를 직접 넣으면 불필요)
#   - Web 서비스 URL: 운영 도메인(및 개발 시 http://localhost:3000) 등록
#   - 발급된 Client ID 를 아래에 입력 (Client Secret 은 필요 없음)
NAVER_MAP_CLIENT_ID=
# 지도 표시 위치(선택). 비워 두면 관리자 > 기관 정보의 주소로 위치를 찾습니다.
#   예: 건물 입구 등 정확한 지점을 찍고 싶을 때 위도·경도 입력
NAVER_MAP_LAT=
NAVER_MAP_LNG=

# 업로드 파일 저장 위치 (기본: ./data/uploads)
# UPLOAD_DIR=
